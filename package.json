{
  "name": "blockchain-ecommerce-system",
  "version": "1.0.0",
  "description": "Blockchain-Based Secure E-Commerce Transaction System with Escrow and Verified Reviews",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy": "hardhat run scripts/deploy.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "vercel-build": "npm --prefix frontend install && npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "blockchain",
    "ecommerce",
    "solidity",
    "hardhat",
    "escrow",
    "smart-contracts",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.18"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0"
  }
}
